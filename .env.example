NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=YOUR_BROWSER_RESTRICTED_MAPS_KEY
NEXT_PUBLIC_GOOGLE_MAP_ID=YOUR_MAP_ID

# Local demo setup only. Never use a NEXT_PUBLIC_ prefix for this key.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only. Used to machine-translate listing titles/descriptions (th/my/zh)
# and to bootstrap the static UI dictionaries via scripts/translate-dictionary.mjs.
GOOGLE_TRANSLATE_API_KEY=
